{
  "name": "ai-api-doctor",
  "version": "0.2.0",
  "description": "Diagnose OpenAI-compatible API keys, Base URLs, model access, usage and client configs.",
  "type": "module",
  "scripts": {
    "prepare": "node -e \"const fs=require('fs');['dev/entrypoints/popup','dev/public'].forEach(d=>fs.mkdirSync(d,{recursive:true}));['entrypoints','src'].forEach(s=>{const src='./'+s,dist='./dev/'+s;fs.rmSync(dist,{recursive:true,force:true});fs.cpSync(src,dist,{recursive:true})});\"",
    "dev": "npm run prepare && wxt dev",
    "build": "wxt build",
    "build:dev": "npm run prepare && wxt build",
    "rebuild": "npm run build"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "lucide-react": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "wxt": "^0.20.25"
  }
}
