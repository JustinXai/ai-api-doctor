{
  "name": "ai-api-doctor",
  "version": "0.2.0",
  "description": "Diagnose OpenAI-compatible API keys, Base URLs, model access, usage and client configs.",
  "type": "module",
  "scripts": {
    "prepare": "node -e \"const fs=require('fs');['dev/entrypoints/popup','dev/public/_locales/en','dev/public/_locales/zh_CN'].forEach(d=>fs.mkdirSync(d,{recursive:true}));fs.cpSync('./entrypoints','./dev/entrypoints',{recursive:true,filter:(src)=>!src.includes('node_modules')});fs.cpSync('./src','./dev/src',{recursive:true,filter:(src)=>!src.includes('node_modules')});fs.cpSync('./public','./dev/public',{recursive:true});\"",
    "dev": "npm run prepare && wxt dev",
    "build": "wxt build",
    "build:dev": "npm run prepare && wxt build",
    "rebuild": "npm run build"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "wxt": "^0.20.25"
  }
}
